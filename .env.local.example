# ─── Firebase client SDK (public — safe to expose to the browser) ────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ─── AI provider (SERVER-ONLY — never prefix these with NEXT_PUBLIC) ──────────
# Added in the deployment environment later. If ANTHROPIC_API_KEY is absent, the
# app falls back to a clearly-labelled development mock so nothing breaks.
ANTHROPIC_API_KEY=
# Optional override: 'anthropic' | 'mock'. Unset = auto (real key → anthropic, else mock).
AI_PROVIDER=

# ─── Firebase Admin (SERVER-ONLY — used to verify ID tokens on API routes) ────
# Not required in Phase 0. Configure before Phase 2 (auth) ships.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the full key; literal "\n" sequences are normalised to newlines at runtime.
FIREBASE_ADMIN_PRIVATE_KEY=

# ─── Feature flags (public — control staged rollout; all default OFF) ─────────
# Set to "true" or "1" to enable. Map* and Face* are experimental ("coming soon").
NEXT_PUBLIC_FLAG_PREMIUM_DESIGN=
NEXT_PUBLIC_FLAG_AUTH_ACCOUNTS=
NEXT_PUBLIC_FLAG_ITINERARY_PRO=
NEXT_PUBLIC_FLAG_AI_FEATURES=
NEXT_PUBLIC_FLAG_BUDGET_PRO=
NEXT_PUBLIC_FLAG_PHOTOS=
NEXT_PUBLIC_FLAG_PHOTO_EDITING=
NEXT_PUBLIC_FLAG_COLLABORATION=
NEXT_PUBLIC_FLAG_SHARING_LINKS=
NEXT_PUBLIC_FLAG_MAP_FEATURES=
NEXT_PUBLIC_FLAG_FACE_GROUPING=
