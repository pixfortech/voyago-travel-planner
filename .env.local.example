# ─────────────────────────────────────────────────────────────────────────────
# Voyago Travel Planner — environment template
#
# HOW TO USE:
#   1. Copy this file to `.env.local`   →   cp .env.local.example .env.local
#   2. Fill in the value marked "COPY FROM FIREBASE CONSOLE" below.
#   3. Restart the dev server after any change   →   npm run dev
#
# `.env.local` holds YOUR real keys. It is git-ignored (see .gitignore) and must
# NEVER be committed. This template ships only safe placeholders — no secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Firebase Web App config (public — safe to expose to the browser) ─────────
# REQUIRED for the app to start. The app validates these on startup and prints a
# clear error if any are missing or still a placeholder.
#
# apiKey — COPY FROM FIREBASE CONSOLE (keep your real key local only, never commit):
#   Firebase Console → Project settings (gear icon) → "Your apps" → Web app → SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
# The values below are the public identifiers for the voyago-travel-planner-ai project.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=voyago-travel-planner-ai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=voyago-travel-planner-ai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=voyago-travel-planner-ai.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=579482732347
NEXT_PUBLIC_FIREBASE_APP_ID=1:579482732347:web:5acd4ec7e215052e97d91e

# ─── AI provider (SERVER-ONLY — never prefix these with NEXT_PUBLIC) ──────────
# Development-safe defaults. With AI_PROVIDER=mock the app uses a clearly-labelled
# mock and needs no real key, so nothing breaks during local testing.
AI_PROVIDER=mock
# Leave blank for local dev. Add the real key in the deployment environment later.
ANTHROPIC_API_KEY=

# ─── Firebase Admin (SERVER-ONLY — used to verify ID tokens on API routes) ────
# Not required for local testing. Configure before Phase 2 (auth) ships.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the full key; literal "\n" sequences are normalised to newlines at runtime.
FIREBASE_ADMIN_PRIVATE_KEY=

# ─── Google Maps Platform (PUBLIC — not required yet; needed for Phase 11) ────
# Enable Maps JavaScript API, Places API, and Directions API in Google Cloud Console.
# Leave blank until the mapFeatures flag ships.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Feature flags (public — control staged rollout; all default OFF) ─────────
# Set to "true" or "1" to enable. Map* and Face* are experimental ("coming soon").
NEXT_PUBLIC_FLAG_PREMIUM_DESIGN=
NEXT_PUBLIC_FLAG_AUTH_ACCOUNTS=
NEXT_PUBLIC_FLAG_ITINERARY_PRO=
NEXT_PUBLIC_FLAG_AI_FEATURES=
NEXT_PUBLIC_FLAG_BUDGET_PRO=
NEXT_PUBLIC_FLAG_PHOTOS=
NEXT_PUBLIC_FLAG_PHOTO_EDITING=
NEXT_PUBLIC_FLAG_COLLABORATION=
NEXT_PUBLIC_FLAG_SHARING_LINKS=
NEXT_PUBLIC_FLAG_MAP_FEATURES=
NEXT_PUBLIC_FLAG_FACE_GROUPING=
