rules_version = '2';

// Voyago Firebase Storage security rules.
//
// Storage was created in production mode (default deny), so these rules must be
// deployed before any upload/download works:
//   firebase deploy --only storage
//
// Trip photo memories (Phase 7B) are stored under
// trips/{tripId}/memories/{memoryId}/{file}. Access to a trip's media requires
// membership of that trip, cross-checked against the Firestore trip document.
// Avatars are private to each user. There is NO public access.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Cross-check trip membership against the Firestore trip document.
    function isTripMember(tripId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/trips/$(tripId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/trips/$(tripId)).data.members;
    }

    // Trip media (photos, receipts): members of the trip only.
    match /trips/{tripId}/{allPaths=**} {
      allow read, write: if isTripMember(tripId);
    }

    // User avatars: each user may only manage their own.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
