# ────────────────────────────────────────────────────────────────────────────
# Voyago — environment variable reference
#
# Copy to .env.local for local development.
# In production (Firebase App Hosting / Cloud Run) set these in apphosting.yaml.
# NEVER commit real keys or secrets to source control.
# ────────────────────────────────────────────────────────────────────────────

# ── Firebase client config (safe to be public, scoped to your Firebase project) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Google Maps browser key (HTTP-referrer restricted, safe to be public) ────
# Used by client-side Maps JS (Place Picker, interactive map).
# DO NOT use this key for server-side API calls — it will be rejected with 403
# when called from Cloud Run (no HTTP referrer header).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Google Maps SERVER key (unrestricted or IP-restricted — KEEP SECRET) ────
# Used by API routes: Places API (New), Routes API, Route Optimization API.
# In production: store as "googleMapsApiKey" secret in Secret Manager and
# reference it in apphosting.yaml as:
#   - variable: GOOGLE_MAPS_API_KEY
#     secret: googleMapsApiKey
#     availability: [RUNTIME]
# Grant the Cloud Run service account roles/secretmanager.secretAccessor.
GOOGLE_MAPS_API_KEY=

# ── Anthropic API key (KEEP SECRET) ─────────────────────────────────────────
# Required for AI trip generation and itinerary features.
# In production: store as "anthropicApiKey" secret in Secret Manager and
# reference it in apphosting.yaml as:
#   - variable: ANTHROPIC_API_KEY
#     secret: anthropicApiKey
#     availability: [RUNTIME]
ANTHROPIC_API_KEY=

# ── AI provider override ─────────────────────────────────────────────────────
# "anthropic" — require ANTHROPIC_API_KEY (throws if missing).
# "mock"      — always use the deterministic dev mock (clearly labelled in UI).
# (unset)     — auto: use Anthropic if key is set; mock if not (dev only).
#               In production with no key and no override, the server returns
#               an error instead of silently using mock data.
AI_PROVIDER=

# ── Feature flags (NEXT_PUBLIC_ flags are baked in at build time) ────────────
NEXT_PUBLIC_FLAG_MAP_FEATURES=true
