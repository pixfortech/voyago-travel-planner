rules_version = '2';

// Voyago Firestore security rules.
//
// Data model:
//   users/{uid}                     → one profile doc per user (private)
//   trips/{tripId}                  → has ownerId (string) + members (array of uids)
//   trips/{tripId}/days/{dayId}     → itinerary days (inherit trip membership)
//   trips/{tripId}/expenses/{id}    → expenses (inherit trip membership)
//
// Auth model (Phase 2C):
//   - Every visitor signs in anonymously by default.
//   - Users may upgrade to Google or Email/Password while preserving their uid
//     via Firebase linkWithCredential / linkWithPopup.
//   - When linking succeeds the uid is unchanged, so existing trip membership
//     requires no migration.
//   - ownerId cannot be changed client-side; that requires Firebase Admin SDK.
//
// Deploy:
//   firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // A user is a member of an existing trip document.
    function isTripMember(tripId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/trips/$(tripId))
        && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.members;
    }

    // User profiles: a user may only read/write their own profile.
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Share snapshots (Phase 3 — public read-only trip sharing).
    //
    // shares/{shareId} holds a denormalised, read-only snapshot containing ONLY
    // the sections the owner chose to expose (see buildSnapshot). It does NOT
    // grant any access to the underlying trip/expense documents.
    //
    //   • Public read is allowed ONLY when enabled == true — anyone (including
    //     logged-out visitors) can read an enabled share. Disabled shares are
    //     readable only by their owner.
    //   • Only the trip owner (matching ownerId) may create, update, or delete.
    match /shares/{shareId} {
      allow read: if resource.data.enabled == true
        || (isSignedIn() && request.auth.uid == resource.data.ownerId);

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.ownerId;

      // Owner may update their share but cannot change its ownerId.
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.ownerId
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.ownerId;
    }

    // Trips: members can read; creator must own and include self in members.
    // Update has two permitted shapes:
    //   1. Standard data update — ownerId and members unchanged (anyone in members).
    //   2. Member extension — owner adds new members without removing existing ones
    //      or changing ownerId. Required for future collaboration and migration prep.
    match /trips/{tripId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.ownerId
        && request.auth.uid in request.resource.data.members;

      allow update: if isSignedIn() && (
        // Shape 1: any member may update trip data; ownerId and members are immutable.
        (request.auth.uid in resource.data.members
         && request.resource.data.ownerId == resource.data.ownerId
         && request.resource.data.members == resource.data.members)
        ||
        // Shape 2: the owner may extend the members list (add new members).
        // Constraints: owner stays in members, ownerId unchanged, no removals.
        (request.auth.uid in resource.data.members
         && request.auth.uid == resource.data.ownerId
         && request.resource.data.ownerId == resource.data.ownerId
         && request.auth.uid in request.resource.data.members
         && request.resource.data.members.hasAll(resource.data.members))
      );

      allow delete: if isSignedIn() && request.auth.uid in resource.data.members;

      // Nested collections (days, expenses, future media) inherit trip membership.
      match /{sub=**} {
        allow read, write: if isTripMember(tripId);
      }
    }
  }
}
