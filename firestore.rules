rules_version = '2';

// Voyago Firestore security rules.
//
// Data model (current, anonymous-auth trip sharing):
//   users/{uid}                     → one profile doc per user (private)
//   trips/{tripId}                  → has ownerId (string) + members (array of uids)
//   trips/{tripId}/days/{dayId}     → itinerary days (inherit trip membership)
//   trips/{tripId}/expenses/{id}    → expenses (inherit trip membership)
//
// Principle: a signed-in user (including anonymous users) may only read or write
// trips they are a member of, plus the nested data of those trips. There is NO
// public access. Firestore was created in production mode (default deny), so
// these rules MUST be deployed before any read/write works:
//   firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // A user is a member of an existing trip document.
    function isTripMember(tripId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/trips/$(tripId))
        && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.members;
    }

    // User profiles: a user may only read/write their own profile.
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Trips: members can read; creator must own and include self in members;
    // members can update/delete, but ownerId and members are immutable on update
    // (collaboration in Phase 9 will relax this with dedicated invite logic).
    match /trips/{tripId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.ownerId
        && request.auth.uid in request.resource.data.members;

      allow update: if isSignedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.members == resource.data.members;

      allow delete: if isSignedIn() && request.auth.uid in resource.data.members;

      // Nested collections (days, expenses, future media metadata) inherit
      // access from trip membership.
      match /{sub=**} {
        allow read, write: if isTripMember(tripId);
      }
    }
  }
}
